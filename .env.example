# ============================================================
# Rinova Web Control — contoh konfigurasi environment
# Salin file ini menjadi `.env.local`, lalu isi nilainya.
# Untuk deploy Vercel: isi variabel yang sama di Project Settings → Environment Variables.
# ============================================================

# --- MongoDB Atlas (WAJIB) ---
# Satu cluster Atlas cukup — bedakan nama database di bawah.
# Contoh: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# PENTING untuk Vercel: di Atlas → Network Access → izinkan 0.0.0.0/0
MONGODB_URI=

# Nama database akun admin panel web (boleh sama-sama di cluster Atlas)
ADMIN_DB_NAME=rinova_admin
# Nama database ASLI aplikasi Android (JANGAN diubah kecuali yakin)
APP_DB_NAME=rinova

# (Opsional) URI terpisah bila admin & aplikasi beda cluster.
# Bila dikosongkan, memakai MONGODB_URI.
# ADMIN_MONGODB_URI=
# APP_MONGODB_URI=

# --- Auth.js (WAJIB) ---
# String acak panjang. Generate: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# URL publik web (lokal). Di Vercel TIDAK perlu diisi (otomatis).
NEXTAUTH_URL=http://localhost:3000

# --- Seed admin awal (dipakai `npm run seed`, sekali saja) ---
SEED_ADMIN_EMAIL=admin@rinova.local
SEED_ADMIN_NAME=Rinova Admin
SEED_ADMIN_PASSWORD=ganti-password-minimal-8-karakter
